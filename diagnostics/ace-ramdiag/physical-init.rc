# Physical RAM stage2; startup gates precede adbd and exact UDC binding.
on early-init
    copy /system/etc/ld.config.txt /linkerconfig/ld.config.txt
    chmod 0444 /linkerconfig/ld.config.txt
    mkdir /sys/fs/pstore 0755 root root
    mount pstore pstore /sys/fs/pstore
    start ueventd

on init
    export PATH /system/bin
    symlink /proc/self/fd /dev/fd
    # Original ueventd configuration is neutralized in the full overlay.
    # adbd drops capabilities; supply standard RAM character-node permissions.
    chmod 0666 /dev/null
    chmod 0666 /dev/random
    chmod 0666 /dev/urandom
    start ramdiag_startup

service ueventd /system/bin/ueventd
    user root
    group root
    seclabel u:r:ueventd:s0
    disabled

service adbd /system/bin/adbd --root_seclabel=u:r:recovery:s0 --device_banner=recovery
    user root
    group root
    socket adbd stream 0600 root root
    seclabel u:r:recovery:s0
    disabled
    oneshot
    stdio_to_kmsg
    setenv ADB_TRACE all

service ramdiag_startup /system/bin/sh /ace-ramdiag/physical-startup.sh
    user root
    group root
    seclabel u:r:recovery:s0
    disabled
    oneshot

on property:sys.ace.ramdiag.ready=ramdiag-v1
    start adbd

import /ace-ramdiag/physical-usb.rc
