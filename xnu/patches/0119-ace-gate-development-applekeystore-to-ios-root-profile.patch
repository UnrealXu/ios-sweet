--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -24,6 +24,10 @@
 #include <IOKit/IOMemoryDescriptor.h>
 #include <libkern/c++/OSString.h>
 #include <sys/proc.h>
+#if defined(ARM64_BOARD_CONFIG_ACE)
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#endif
 
 /* libaks selectors (AppleKeyStore.framework, iOS 16.7). */
 enum {
@@ -68,15 +72,54 @@
 
 OSDefineMetaClassAndStructors(AppleKeyStore, IOService);
 
+#if defined(ARM64_BOARD_CONFIG_ACE)
+/* Explicit profile4 development software interface only. No MMIO, SMC, SEP
+ * or hardware key store is accessed. A plain diagnostic profile never starts
+ * this service. Check exact DT bytes rather than PE_get_default's max-size
+ * semantics, which also accepts undersized values.
+ */
+static bool
+ace_development_aks_enabled(void)
+{
+	char root[32] = { 0 };
+	if (!PE_parse_boot_argn("rd", root, sizeof(root))) {
+		return false;
+	}
+	root[sizeof(root) - 1] = 0;
+	if (strcmp(root, "aceufsroot0") != 0) {
+		return false;
+	}
+	DTEntry entry = NULL;
+	const void *data = NULL;
+	unsigned int bytes = 0;
+	if (SecureDTLookupEntry(NULL, "/defaults", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "no-effaceable-storage", &data, &bytes) != kSuccess ||
+	    data == NULL || bytes != 4) {
+		return false;
+	}
+	const uint8_t *value = (const uint8_t *)data;
+	return value[0] == 1 && value[1] == 0 && value[2] == 0 && value[3] == 0;
+}
+#endif
+
 bool
 AppleKeyStore::start(IOService *provider)
 {
+#if defined(ARM64_BOARD_CONFIG_ACE)
+	if (!ace_development_aks_enabled()) {
+		return false;
+	}
+#endif
 	if (!IOService::start(provider)) {
 		return false;
 	}
 	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
 	registerService();
+#if defined(ARM64_BOARD_CONFIG_ACE)
+	IOLog("ACE AKS: development software AppleKeyStore registered (no passcode, unlocked; no SEP)\n");
+#else
 	IOLog("SWEET AKS: AppleKeyStore registered (no passcode, unlocked)\n");
+#endif
 	return true;
 }
 
