+    void inspect_vendor_link(const char *stage) {
+        /* MTK debug mux is not a link reset. Preserve every selector and never
+         * interpret a raw/unselected PROBE word as VS_LINK_UP. */
+        uint32_t hw=rd(0x2240),major=(hw>>16)&255;
+        if(hw==0 || hw==0xffffffffu || major==0 || major==255 ||
+           !inherited_ready() || (rd(0x144)&3)!=3) {
+            printf("ACE UFS state: %s unavailable HW=%08x; no debug writes\n",stage,hw);return;
+        }
+        const unsigned offsets[5]={0x22c0,0x22d0,0x22d4,0x22d8,0x22dc};
+        const uint32_t modern[5]={0x820820,0,0x55555555,0xaaaaaaaa,0xffffffff};
+        uint32_t saved[5],count=major>=0x36?5:1;
+        bool selected=true;
+        for(unsigned i=0;i<count;i++) saved[i]=rd(offsets[i]);
+        for(unsigned i=0;i<count;i++) wr(offsets[i],count==5?modern[i]:0x20);
+        for(unsigned i=0;i<count;i++)
+            if(rd(offsets[i])!=(count==5?modern[i]:0x20)) selected=false;
+        uint32_t first=0,second=0;
+        if(selected) { first=rd(0x22c8);IODelay(1);second=rd(0x22c8); }
+        for(unsigned i=count;i>0;i--) wr(offsets[i-1],saved[i-1]);
+        bool restored=true;
+        for(unsigned i=0;i<count;i++) if(rd(offsets[i])!=saved[i]) restored=false;
+        printf("ACE UFS state: %s HW=%08x major=%02x mux-selected=%u restored=%u PROBE=%08x/%08x link=%u/%u host=%u/%u\n",
+            stage,hw,major,(unsigned)selected,(unsigned)restored,first,second,
+            first>>28,second>>28,first&31,second&31);
+        /* Diagnostic observations only: even link=2 is not a genuine NOP,
+         * descriptor DMA, media read or root-mount success. */
+    }
