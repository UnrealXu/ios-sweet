diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -16,6 +16,18 @@
 #define NO_ECORE                  1
 
 #define SWEET                     1
+
+/* Fixed Redmi framebuffer, independent of the generic ARM/GIC adaptations.
+ * A new platform must leave this disabled until its framebuffer mapping and
+ * ownership are established. Override with -DSWEET_HAS_EARLY_FB=0 for the
+ * headless bootstrap; this alone does NOT make a SWEET kernel Ace-compatible.
+ */
+#ifndef SWEET_HAS_EARLY_FB
+#define SWEET_HAS_EARLY_FB        1
+#endif
+#if SWEET_HAS_EARLY_FB != 0 && SWEET_HAS_EARLY_FB != 1
+#error "SWEET_HAS_EARLY_FB must be 0 or 1"
+#endif
 
 /*
  * All eight cores (six A55 + two A76) as one homogeneous SMP cluster:
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -513,7 +513,7 @@
