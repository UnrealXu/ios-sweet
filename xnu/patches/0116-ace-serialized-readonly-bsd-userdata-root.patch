diff --git a/bsd/dev/ace_ufs.c b/bsd/dev/ace_ufs.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/ace_ufs.c
@@ -0,0 +1,154 @@
+/* ACE readonly BSD root facade. The IOKit singleton owns all UFS state.
+ * No MMIO, DMA allocation, HBA initialization or storage writes in this file. */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_ACE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+
+extern void IOSleep(unsigned milliseconds);
+extern int ace_ufs_root_geometry(uint64_t *bytes);
+extern int ace_ufs_root_read(uint64_t offset, void *destination, size_t count, size_t *done);
+int ace_ufs_rootdev(dev_t *dev);
+static LCK_GRP_DECLARE(ace_bsd_grp, "ace_ufs_bsd");
+static LCK_MTX_DECLARE(ace_bsd_init_lock, &ace_bsd_grp);
+static uint64_t ace_bytes;
+static dev_t ace_bdev;
+static int ace_bsd_ready;
+/* Static: never spend a 4KiB kernel stack on this read proof. */
+static uint8_t ace_read_proof[4096];
+
+static int
+ace_open(dev_t dev, int flags, __unused int type, __unused struct proc *p)
+{
+    uint64_t bytes;
+    if(minor(dev) || !__atomic_load_n(&ace_bsd_ready,__ATOMIC_ACQUIRE)) return ENXIO;
+    if(flags & FWRITE) return EROFS;
+    return ace_ufs_root_geometry(&bytes);
+}
+static int
+ace_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+    return 0;
+}
+static void
+ace_strategy(buf_t bp)
+{
+    uint32_t count=buf_count(bp);
+    size_t done=0;
+    caddr_t address=NULL;
+    int error=0;
+    uint64_t offset=0;
+    daddr64_t sector=buf_blkno(bp);
+    buf_setresid(bp,count);
+    if(!(buf_flags(bp)&B_READ)) {error=EROFS;goto finish;}
+    if(!__atomic_load_n(&ace_bsd_ready,__ATOMIC_ACQUIRE) || minor(buf_device(bp))) {error=ENXIO;goto finish;}
+    if(sector<0 || (uint64_t)sector>UINT64_MAX/DEV_BSIZE || count>65536) {error=EINVAL;goto finish;}
+    offset=(uint64_t)sector*DEV_BSIZE;
+    if(offset>ace_bytes || count>ace_bytes-offset) {error=EINVAL;goto finish;}
+    if(!count) goto finish;
+    if(buf_map(bp,&address)) {error=EIO;goto finish;}
+    error=ace_ufs_root_read(offset,address,count,&done);
+    /* Only the singleton may report progress; never underflow a BSD residual. */
+    if(done>count) {done=0;error=EIO;}
+    buf_setresid(bp,count-(uint32_t)done);
+    buf_unmap(bp);
+finish:
+    if(error) buf_seterror(bp,error);
+    buf_biodone(bp);
+}
+static int
+ace_ioctl(dev_t dev,u_long command,caddr_t data,__unused int flags,__unused struct proc *p)
+{
+    uint64_t bytes;
+    if(minor(dev) || !__atomic_load_n(&ace_bsd_ready,__ATOMIC_ACQUIRE)) return ENXIO;
+    int error=ace_ufs_root_geometry(&bytes);
+    if(error) return error;
+    switch(command) {
+    case DKIOCGETBLOCKSIZE: *(uint32_t *)data=DEV_BSIZE;return 0;
+    case DKIOCSETBLOCKSIZE: return *(uint32_t *)data==DEV_BSIZE?0:EINVAL;
+    case DKIOCGETPHYSICALBLOCKSIZE: *(uint32_t *)data=4096;return 0;
+    case DKIOCGETBLOCKCOUNT: *(uint64_t *)data=bytes/DEV_BSIZE;return 0;
+    case DKIOCISWRITABLE: *(uint32_t *)data=0;return 0;
+    case DKIOCGETMAXBLOCKCOUNTREAD: *(uint64_t *)data=65536/DEV_BSIZE;return 0;
+    case DKIOCGETMAXBLOCKCOUNTWRITE: *(uint64_t *)data=0;return 0;
+    case DKIOCGETMAXSEGMENTCOUNTREAD: *(uint64_t *)data=1;return 0;
+    case DKIOCGETMAXSEGMENTCOUNTWRITE: *(uint64_t *)data=0;return 0;
+    default: return ENOTTY;
+    }
+}
+static int ace_psize(__unused dev_t dev) {return -1;} /* capacity via 64-bit ioctl */
+static u_int ace_minphys(buf_t bp) {minphys(bp);if(buf_count(bp)>65536) buf_setcount(bp,65536);return buf_count(bp);}
+static int ace_read(dev_t dev,struct uio *uio,__unused int flags)
+{
+    return physio(ace_strategy,NULL,dev,B_READ,ace_minphys,uio,DEV_BSIZE);
+}
+static int ace_write(__unused dev_t dev,__unused struct uio *uio,__unused int flags) {return EROFS;}
+static const struct bdevsw ace_bsw={
+    .d_open=ace_open,.d_close=ace_close,.d_strategy=ace_strategy,.d_ioctl=ace_ioctl,
+    .d_dump=eno_dump,.d_psize=ace_psize,.d_type=D_DISK,
+};
+static const struct cdevsw ace_csw={
+    .d_open=ace_open,.d_close=ace_close,.d_read=ace_read,.d_write=ace_write,
+    .d_ioctl=ace_ioctl,.d_stop=eno_stop,.d_reset=eno_reset,.d_ttys=NULL,
+    .d_select=eno_select,.d_mmap=eno_mmap,.d_strategy=eno_strat,
+    .d_reserved_1=eno_getc,.d_reserved_2=eno_putc,.d_type=D_DISK,
+};
+static int
+ace_register(void)
+{
+    int error=EAGAIN;
+    /* Provider may still be running on the sole CPU. Sleep rather than spin. */
+    for(unsigned i=0;i<1000;i++) {
+        error=ace_ufs_root_geometry(&ace_bytes);
+        if(error!=EAGAIN) break;
+        IOSleep(10);
+    }
+    if(error) return error;
+    size_t done=0;
+    error=ace_ufs_root_read(0,ace_read_proof,sizeof(ace_read_proof),&done);
+    if(error || done!=sizeof(ace_read_proof)) return error?error:EIO;
+    uint32_t crc=0xffffffffu;
+    for(unsigned i=0;i<sizeof(ace_read_proof);i++) {
+        crc^=ace_read_proof[i];
+        for(unsigned j=0;j<8;j++) crc=(crc>>1)^(0xedb88320u&(0u-(crc&1)));
+    }
+    printf("ACE UFS BSD: userdata first4096 CRC32=%08x; readonly bridge read verified, no filesystem claim\n",~crc);
+    bzero(ace_read_proof,sizeof(ace_read_proof));
+    int bm=bdevsw_add(-1,&ace_bsw);
+    if(bm<0) return ENXIO;
+    int cm=cdevsw_add_with_bdev(-1,&ace_csw,bm);
+    if(cm<0) {bdevsw_remove(bm,&ace_bsw);return ENXIO;}
+    ace_bdev=makedev(bm,0);
+    void *block=devfs_make_node(ace_bdev,DEVFS_BLOCK,UID_ROOT,GID_OPERATOR,0640,"aceufsroot0");
+    void *raw=devfs_make_node(makedev(cm,0),DEVFS_CHAR,UID_ROOT,GID_OPERATOR,0640,"raceufsroot0");
+    if(!block || !raw) {
+        if(block) devfs_remove(block);
+        if(raw) devfs_remove(raw);
+        cdevsw_remove(cm,&ace_csw);bdevsw_remove(bm,&ace_bsw);
+        return ENXIO;
+    }
+    __atomic_store_n(&ace_bsd_ready,1,__ATOMIC_RELEASE);
+    printf("ACE UFS BSD: aceufsroot0 ready bytes=%llu sector=512 physical=4096 readonly\n",ace_bytes);
+    return 0;
+}
+int
+ace_ufs_rootdev(dev_t *dev)
+{
+    if(!dev) return EINVAL;
+    lck_mtx_lock(&ace_bsd_init_lock);
+    int error=__atomic_load_n(&ace_bsd_ready,__ATOMIC_ACQUIRE)?0:ace_register();
+    if(!error) *dev=ace_bdev;
+    lck_mtx_unlock(&ace_bsd_init_lock);
+    return error;
+}
+#endif
