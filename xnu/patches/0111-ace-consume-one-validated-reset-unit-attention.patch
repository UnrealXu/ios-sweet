--- /dev/null
+++ b/iokit/Kernel/arm/AceUFSResetAttention.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: MIT
+ * Narrow readiness handling for the actual post-reset LUN2 Unit Attention.
+ * Requires the read-probe header first. This is not a general SCSI retry rule.
+ */
+#ifndef ACE_UFS_RESET_ATTENTION_H
+#define ACE_UFS_RESET_ATTENTION_H
+static inline int ace_ufs_reset_attention_response(const uint8_t *r,size_t bytes,unsigned lun) {
+    if(!r || bytes!=512 || lun!=2 || r[0]!=0x21 || r[1] || r[2]!=lun || r[3] ||
+       r[4] || r[5] || r[6]>1 || r[7]!=2 || r[8] || r[9] || r[10] || r[11]!=20 || ace_ufs_be32(r+12) ||
+       r[32] || r[33]!=18 || r[34]!=0x70 || r[36]!=6 || r[41]!=10 ||
+       r[46]!=0x29 || r[47]) return 0;
+    return 1; /* Fixed18-byte sense, current reset UA06/29/00 only. */
+}
+#endif
