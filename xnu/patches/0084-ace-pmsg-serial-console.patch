diff --git a/pexpert/arm/pe_ace_pmsg.c b/pexpert/arm/pe_ace_pmsg.c
new file mode 100644
--- /dev/null
+++ b/pexpert/arm/pe_ace_pmsg.c
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: MIT */
+#if defined(ARM64_BOARD_CONFIG_ACE)
+#include <pexpert/arm/ace_pmsg.h>
+#if __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error "Ace pmsg producer requires little-endian accesses"
+#endif
+
+static int
+ace_pmsg_object_ok(const struct ace_pmsg_console *console)
+{
+	return console && (uintptr_t)console % _Alignof(struct ace_pmsg_console) == 0 &&
+	       (uintptr_t)console <= UINTPTR_MAX - sizeof(*console);
+}
+
+static int
+ace_pmsg_zone_ok(const volatile void *zone, size_t bytes)
+{
+	return zone && bytes == ACE_PMSG_BYTES && (uintptr_t)zone % 4 == 0 &&
+	       (uintptr_t)zone <= UINTPTR_MAX - bytes;
+}
+
+static int
+ace_pmsg_state(const volatile uint8_t *zone, uint32_t *start, uint32_t *size)
+{
+	const volatile uint32_t *header = (const volatile uint32_t *)zone;
+	if (header[0] != ACE_PMSG_SIGNATURE) {
+		return ACE_PMSG_HEADER;
+	}
+	*start = header[1];
+	*size = header[2];
+	if (*size > ACE_PMSG_CAPACITY || *start >= ACE_PMSG_CAPACITY ||
+	    (*size < ACE_PMSG_CAPACITY && *start != *size)) {
+		return ACE_PMSG_STATE;
+	}
+	return ACE_PMSG_OK;
+}
+
+int
+ace_pmsg_console_bind(struct ace_pmsg_console *console, volatile void *zone, size_t bytes)
+{
+	uint32_t start, size;
+	if (!ace_pmsg_object_ok(console) || !ace_pmsg_zone_ok(zone, bytes)) {
+		return ACE_PMSG_ARGUMENT;
+	}
+	if ((uintptr_t)console < (uintptr_t)zone + bytes &&
+	    (uintptr_t)zone < (uintptr_t)console + sizeof(*console)) {
+		return ACE_PMSG_ALIAS;
+	}
+	if (console->zone || console->bytes || console->busy) {
+		return ACE_PMSG_STATE;
+	}
+	int error = ace_pmsg_state(zone, &start, &size);
+	if (error) {
+		return error;
+	}
+	console->bytes = bytes;
+	console->zone = zone;
+	return ACE_PMSG_OK;
+}
+
+int
+ace_pmsg_console_putc(struct ace_pmsg_console *console, uint8_t byte)
+{
+	uint32_t expected = 0, start, size;
+	if (!ace_pmsg_object_ok(console)) {
+		return ACE_PMSG_ARGUMENT;
+	}
+	if (!console->zone) {
+		return ACE_PMSG_UNBOUND;
+	}
+	if (!ace_pmsg_zone_ok(console->zone, console->bytes)) {
+		return ACE_PMSG_ARGUMENT;
+	}
+	if (!__atomic_compare_exchange_n(&console->busy, &expected, 1, 0,
+	    __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+		return ACE_PMSG_BUSY;
+	}
+	int error = ace_pmsg_state(console->zone, &start, &size);
+	if (!error) {
+		console->zone[12u + start] = byte;
+		start = start + 1 == ACE_PMSG_CAPACITY ? 0 : start + 1;
+		if (size < ACE_PMSG_CAPACITY) {
+			size++;
+		}
+		/* Publish ordered data then metadata, with no promise of a complete
+		 * record if reset interrupts either of the two header stores. */
+		__atomic_thread_fence(__ATOMIC_RELEASE);
+		volatile uint32_t *header = (volatile uint32_t *)console->zone;
+		header[1] = start;
+		header[2] = size;
+	}
+	__atomic_store_n(&console->busy, 0, __ATOMIC_RELEASE);
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_ACE */
diff --git a/pexpert/pexpert/arm/ace_pmsg.h b/pexpert/pexpert/arm/ace_pmsg.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm/ace_pmsg.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: MIT
+ * Caller-owned, ECC-free little-endian pmsg RAM. No mapping or initialization
+ * of unknown memory. Bind a zeroed, exclusively owned console before publish;
+ * the mapped zone must remain accessible and have no external writer. putc
+ * uses a nonblocking normal-RAM lock; recursive/concurrent output may drop.
+ * Successful return orders data/header stores, not atomic crash publication or
+ * proof of reset retention. Platform code must supply mapping and completion.
+ */
+#ifndef _PEXPERT_ARM_ACE_PMSG_H
+#define _PEXPERT_ARM_ACE_PMSG_H
+#include <stddef.h>
+#include <stdint.h>
+#define ACE_PMSG_BYTES 65536u
+#define ACE_PMSG_CAPACITY (ACE_PMSG_BYTES - 12u)
+#define ACE_PMSG_SIGNATURE UINT32_C(0x43474244)
+struct ace_pmsg_console {
+	volatile uint8_t *zone;
+	size_t bytes;
+	uint32_t busy;
+};
+enum ace_pmsg_result {
+	ACE_PMSG_OK = 0, ACE_PMSG_ARGUMENT = -1, ACE_PMSG_HEADER = -2,
+	ACE_PMSG_STATE = -3, ACE_PMSG_BUSY = -4, ACE_PMSG_UNBOUND = -5,
+	ACE_PMSG_ALIAS = -6
+};
+int ace_pmsg_console_bind(struct ace_pmsg_console *, volatile void *, size_t);
+int ace_pmsg_console_putc(struct ace_pmsg_console *, uint8_t);
+#endif
