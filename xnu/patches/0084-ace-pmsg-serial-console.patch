+#if defined(ARM64_BOARD_CONFIG_ACE)
+/* Explicit opt-in, exact observed ECC-free resource, outside XNU-managed RAM.
+ * This backend starts at normal KPRINTF initialization, not before the MMU. */
+static struct ace_pmsg_console ace_pmsg_console;
+
+static void ace_pmsg_serial_init(void) {}
+static unsigned int ace_pmsg_tx_ready(void) { return 1; }
+static unsigned int ace_pmsg_rx_ready(void) { return 0; }
+static uint8_t ace_pmsg_rx_data(void) { return 0; }
+
+static void
+ace_pmsg_tx_data(uint8_t byte)
+{
+	if (ace_pmsg_console_putc(&ace_pmsg_console, byte) == ACE_PMSG_OK) {
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) ace_pmsg_serial_functions = {
+	.init = ace_pmsg_serial_init,
+	.transmit_ready = ace_pmsg_tx_ready,
+	.receive_ready = ace_pmsg_rx_ready,
+	.transmit_data = ace_pmsg_tx_data,
+	.receive_data = ace_pmsg_rx_data,
+	.device = SERIAL_ACE_PMSG
+};
+
+static void
+ace_pmsg_probe(void)
+{
+	DTEntry entry;
+	const void *property;
+	unsigned int size;
+	uint64_t reg[2];
+	uint32_t ecc, type_signature;
+	unsigned int enabled = 0;
+	static const char compatible[] = "ace,ramoops-pmsg-v1";
+	boot_args *args = (boot_args *)PE_state.bootArgs;
+
+	if (!PE_parse_boot_argn("ace_pmsg", &enabled, sizeof(enabled)) || enabled != 1 ||
+	    !args || args->Revision != 2 || args->Version != 2 || !args->memSize ||
+	    args->physBase > UINT64_MAX - args->memSize ||
+	    __builtin_arm_rsr64("CurrentEL") != 4 ||
+	    (__builtin_arm_rsr64("SCTLR_EL1") & (1ULL << 25))) {
+		return;
+	}
+	if (SecureDTLookupEntry(NULL, "/chosen/ace-pmsg", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "compatible", &property, &size) != kSuccess ||
+	    size != sizeof(compatible) || memcmp(property, compatible, size) != 0) {
+		return;
+	}
+	if (SecureDTGetProperty(entry, "reg", &property, &size) != kSuccess || size != sizeof(reg)) {
+		return;
+	}
+	memcpy(reg, property, sizeof(reg));
+	if (SecureDTGetProperty(entry, "ecc-size", &property, &size) != kSuccess || size != sizeof(ecc)) {
+		return;
+	}
+	memcpy(&ecc, property, sizeof(ecc));
+	if (SecureDTGetProperty(entry, "type-signature", &property, &size) != kSuccess ||
+	    size != sizeof(type_signature)) {
+		return;
+	}
+	memcpy(&type_signature, property, sizeof(type_signature));
+	if (ecc || type_signature || reg[0] != 0x48160000ULL || reg[1] != ACE_PMSG_BYTES ||
+	    (reg[0] < args->physBase + args->memSize && args->physBase < reg[0] + reg[1])) {
+		return;
+	}
+	/* Both ends are 16K aligned: only the four observed resource pages. */
+	volatile void *mapped = (volatile void *)ml_io_map_wcomb(reg[0], reg[1]);
+	if (!mapped || ace_pmsg_console_bind(&ace_pmsg_console, mapped, ACE_PMSG_BYTES)) {
+		return;
+	}
+	register_serial_functions(&ace_pmsg_serial_functions);
+	static const char ready[] = "ACEXNU pmsg serial ready\n";
+	for (unsigned int i = 0; i < sizeof(ready) - 1; i++) {
+		ace_pmsg_tx_data((uint8_t)ready[i]);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_ACE */
+
 /*****************************************************************************/
 
