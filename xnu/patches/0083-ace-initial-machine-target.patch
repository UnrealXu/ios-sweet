diff --git a/pexpert/pexpert/arm64/ACE.h b/pexpert/pexpert/arm64/ACE.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/ACE.h
@@ -0,0 +1,25 @@
+/*
+ * OnePlus Ace PGKM10 / MT6895 initial XNU platform.
+ * Observed native entry: EL1, Cortex-A55, 13MHz CNTFRQ; virtual timer PPI27.
+ * Share generic ARMv8.2/16K/GICv3 definitions, not Qualcomm hardware drivers.
+ * CPU1..7 and all MTK peripheral drivers still need hardware bring-up.
+ */
+#ifndef _PEXPERT_ARM64_ACE_H
+#define _PEXPERT_ARM64_ACE_H
+
+#define ACE 1
+#if defined(SWEET_HAS_EARLY_FB) && SWEET_HAS_EARLY_FB
+#error "Ace has no verified XNU framebuffer backend"
+#endif
+#ifndef SWEET_HAS_EARLY_FB
+#define SWEET_HAS_EARLY_FB 0
+#endif
+#include <pexpert/arm64/SWEET.h>
+#undef SWEET_CPU_NAME
+#define SWEET_CPU_NAME "Cortex-A55 (Ace boot CPU)"
+#undef SWEET_VTIMER_INTID
+#define SWEET_VTIMER_INTID 27
+#undef SWEET_SMP_MAX_CPUS
+#define SWEET_SMP_MAX_CPUS 1
+
+#endif /* _PEXPERT_ARM64_ACE_H */
